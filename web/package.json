{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 5173",
    "build": "astro build",
    "build:subpath": "astro build --outDir dist-subpath --base=/diesel-hifi/",
    "preview": "astro preview --port 4173",
    "check": "astro check --minimumFailingSeverity warning && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tsconfig/svelte": "5.0.4",
    "svelte": "5.57.0",
    "svelte-check": "4.1.4",
    "typescript": "5.7.3",
    "vite": "8.0.13",
    "vitest": "2.1.8",
    "astro": "7.3.1",
    "@astrojs/svelte": "9.0.1",
    "@astrojs/check": "0.9.10",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3"
  }
}
